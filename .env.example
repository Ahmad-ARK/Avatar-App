# Avatar Editor — environment configuration template.
# Copy this file to ".env" and fill in your own values. The real .env is gitignored.
# Most of these can also be set from the app's Settings page (stored in settings.json).

# --- Server ---
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- API keys (required for the pipeline) ---
GROQ_API_KEY=            # Whisper transcription
DEEPSEEK_API_KEY=        # scene planning + vision verification
DEEPSEEK_MODEL=deepseek-v4-flash
PEXELS_API_KEY=          # stock video
PIXABAY_API_KEY=         # stock images

# --- Modal (self-hosted AI image generation) ---
MODAL_ENDPOINT=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Output format ---
OUTPUT_RESOLUTION=1920x1080
OUTPUT_FPS=30
USE_GPU=false            # true = h264_nvenc (needs a supported NVIDIA GPU)

# --- Scene style (avatar vs. visual balance) ---
VISUAL_DENSITY=balanced  # talking_head | balanced | visual_heavy
ENABLE_AVATAR_PIP=false  # show the small corner-avatar over b-roll
